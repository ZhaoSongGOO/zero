/*
 * Zero Standard Library - Core Module
 * Version: Lite 1.0.0
 * Description: Contains fundamental utility functions for value manipulation
 * and basic arithmetic operations.
 */

func print(msg) { native_println(msg); }

typedef __bool_ref {
value:
  bool;
__str__:
  object;
__hash__:
  object;
};

func __bool_print() { native_print(this.value); }

func __bool_hash() { return this.value; }

func Bool(a) {
  return new __bool_ref{value = a, __str__ = __bool_print,
                        __hash__ = __bool_hash};
}

typedef __int_ref {
value:
  int;
__str__:
  object;
__hash__:
  object;
};
func __int_print() { native_print(this.value); }

func __int_hash() { return this.value; }

func Int(a) {
  return new __int_ref{value = a, __str__ = __int_print, __hash__ = __int_hash};
}

typedef __string_ref {
value:
  string;
__str__:
  object;
len:
  object;
substr:
  object;
equal:
  object;
};

func __string_print() { native_print(this.value); }

func __string_len() { return native_string_len(this.value); }

func __string_equal(other) {
  if (this.len() != other.len()) {
    return false;
  }
  // native_string_equal(this, other);
}

func __string_substr(start, size) {
  return native_string_substr(this.value, start, size);
}

func String(s) {
  return new __string_ref{value = s, __str__ = __string_print,
                          len = __string_len, substr = __string_substr,
                          equal = __string_equal};
}

typedef __list_node {
value:
  object;
next:
  __list_node;
};

typedef __list {
root:
  __list_node;
tail:
  __list_node;
count:
  int;
push:
  object;
each:
  object;
get:
  object;
erase:
  object;
};

func __list_push(v) {
  var l = new __list_node{value = v};
  if (this.root == null) {
    this.tail = l;
    this.root = l;
  } else {
    this.tail.next = l;
    this.tail = l;
  }
  this.count = this.count + 1;
  return l;
}

func __list_each(action) {
  if (this.root == null) {
    return null;
  }

  var i = this.root;
  while (i != null) {
    action(i);
    i = i.next;
  }
}

func __list_get(index) {
  if (index >= this.count) {
    return null;
  }

  if (index < 0) {
    return null;
  }

  var i = this.root;
  var j = 0;
  while (i != null) {
    if (j == index) {
      return i;
    }
    j = j + 1;
    i = i.next;
  }
  return null;
}

func __list_erase(index) {
  if (index >= this.count) {
    return null;
  }

  if (index < 0) {
    return null;
  }
  if (index == 0) {
    var n = this.root;
    if (this.count == 1) {
      this.root = null;
      this.tail = null;
      this.count = 0;
    } else {
      this.root = this.root.next;
      this.count = this.count - 1;
    }
    return n;
  }

  var i = this.root;
  var k = null;
  var j = 0;
  while (i != null) {
    if (j == index) {
      if (i.next == null) {
        this.tail = k;
        this.tail.next = null;
      } else {
        k.next = i.next;
      }
      this.count = this.count - 1;
      return i;
    }
    j = j + 1;
    k = i;
    i = i.next;
  }
}

func List() {
  return new __list{push = __list_push, count = 0, each = __list_each,
                    get = __list_get, erase = __list_erase};
}

typedef __map_node {
key:
  object;
value:
  object;
left:
  __map_node;
right:
  __map_node;
};

typedef __map {
root:
  __map_node;
count:
  int;
insert:
  object;
find:
  object;
each:
  object;
};

func __map_insert_helper(node, key, value) {
  if (node.key.__hash__() == key.__hash__()) {
    node.value = value;
    return node;
  }
  var b = node.key.__hash__() < key.__hash__();
  if (b) {
    if (node.left == null) {
      node.left = new __map_node{key = key, value = value};
      return node.left;
    } else {
      return __map_insert_helper(node.left, key, value);
    }
  } else {
    if (node.right == null) {
      node.right = new __map_node{key = key, value = value};
      return node.right;
    } else {
      return __map_insert_helper(node.right, key, value);
    }
  }
}

func __map_insert(key, value) {
  if (this.root == null) {
    this.root = new __map_node{key = key, value = value};
    this.count = 0;
    return this.root;
  }
  this.count = this.count + 1;
  return __map_insert_helper(this.root, key, value);
}

func __map_find_helper(node, key) {
  if (node == null) {
    return null;
  }
  if (node.key.__hash__() == key.__hash__()) {
    return node;
  }
  if (node.key.__hash__() < key.__hash__()) {
    return __map_find_helper(node.left, key);
  } else {
    return __map_find_helper(node.right, key);
  }
}

func __map_find(key) { return __map_find_helper(this.root, key); }

func __map_each_helper(node, action) {
  if (node == null) {
    return null;
  }
  action(node);
  __map_each_helper(node.left, action);
  __map_each_helper(node.right, action);
}

func __map_each(action) { __map_each_helper(this.root, action); }

func Map() {
  return new __map{count = 0, insert = __map_insert, find = __map_find,
                   each = __map_each};
}

typedef File {
fd:
  int;
};

func open(p) {
  var f = native_open(p);
  return new File{fd = f};
}

func read(file) { return native_read(file); }

// TODO(To be implemented)
func close(file) { native_close(file); }