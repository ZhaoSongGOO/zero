print("Hello");

func sayHi(){
    print("hi");
}

var globalVar = 1;

func visitor(){
    globalVar = 2;
}

func main(){
    var a = 1 + 2 * 3;
    var b = (a + 2) * 3;
    print(a);
    print("Hello World");
    var c = [1.3, 2, 3, a];
    var d = { "key": 1, "address": "abc"};

    var e = false;

    print(false);

    print(true);

    print(1 == 2);
    print(1 != 2);
    print(1 > 2);
    print(1 <= 2);
    print(a == 4);
    sayHi();

    var x = 1;
    print(x+1);
    x = 2 * 3;
    print(x+1);

    var first = 1;
    var second = 2;
    add(first, second);
    print(first+1);

    print(globalVar + 1);
    visitor();
    print(globalVar + 1);

    var z = add(1, 2);
    print(z*2);
}

func add(a, b){
    print(a + b);
    a = -1;
    return a + b;
}