include("std");

func main(){
    var a = [1];
    var b = [2];
    print(a);
    print(b);
    swap(a, b);
    print(a);
    print(b);
    a = 1;
    b = 2;
    print(a);
    print(b);
    swap(a, b);
    print(a);
    print(b);
    a = {"name":"mike"};
    b = {"age":12};
    print(a);
    print(b);
    swap(a, b);
    print(a);
    print(b);
}