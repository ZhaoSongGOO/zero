include("std-library/lite/v1/lib/std-lite-v1");
func main() {
  var s = String("Hello World");
  print(s.startswith(String("Hello")));
  print(s.startswith(String("Hello World")));
  print(s.startswith(String("Hello1")));
  print(s.startswith(String("")));
  print(s.endswith(String("World")));
  print(s.endswith(String("Hello World")));
  print(s.endswith(String("")));
  print(s.endswith(String("Hello WorldHello World"))); 
}