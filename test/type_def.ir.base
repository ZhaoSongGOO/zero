__init__:
customShow:
  LOAD #-1
  PUSH_S data
  GET
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
Int:
  PUSH_S data
  LOAD #-0
  CHECK 1
  PUSH_S show
  LOAD .customShow
  CHECK 5
  PUSH_D 2
  CALL NEW_OBJECT
  STORE [ei]
main:
  PUSH_D 1
  CALL Int
  FREE 1
  LOAD [ei]
  STORE #1
  PUSH_D 2
  CALL Int
  FREE 1
  LOAD [ei]
  STORE #2
  LOAD #1
  COPY
  PUSH_S show
  GET
  CALL -0
  FREE 2
  LOAD [ei]
  FREE 1
  LOAD #2
  COPY
  PUSH_S show
  GET
  CALL -0
  FREE 2
  LOAD [ei]
  FREE 1
  LOAD #1
  PUSH_S data
  GET
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #2
  PUSH_S data
  GET
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #2
  LOAD #1
  CALL swap
  FREE 2
  LOAD [ei]
  FREE 1
  LOAD #1
  PUSH_S data
  GET
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #2
  PUSH_S data
  GET
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #1
  PUSH_S age
  LOAD #1
  CHECK 6
  PUSH_S next
  PUSH_N
  PUSH_D 2
  CALL NEW_OBJECT
  ASSIGN
  STORE #1
  LOAD #2
  PUSH_S age
  LOAD #2
  CHECK 6
  PUSH_S next
  LOAD #1
  CHECK 6
  PUSH_D 2
  CALL NEW_OBJECT
  ASSIGN
  STORE #2
  LOAD #1
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #2
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #2
  PUSH_S age
  LOAD #2
  PUSH_S age
  GET
  CHECK 6
  PUSH_S next
  LOAD #2
  CHECK 6
  PUSH_D 2
  CALL NEW_OBJECT
  ASSIGN
  STORE #2
  LOAD #2
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1