include("std");

func show(a) { print(a); }

func main() {
  var l = List();
  print(l);
  print(l.count);
  l.push(Int(1));
  print(l);
  print(l.count);
  l.push(Int(2));
  print(l);
  print(l.count);
  l.push(Int(3));
  print(l);
  print(l.count);
  l.push(Int(4));
  print(l);
  print(l.count);
  l.push(Int(5));
  print(l);
  print(l.count);
  l.push(Int(6));
  print(l);
  print(l.count);
  print("------------");
  l.each(show);

  var j = -1;
  while (j <= l.count) {
    var x = l.get(j);
    print(x);
    j = j + 1;
  }
}