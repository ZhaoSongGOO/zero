  LOAD [ei]
  STORE #1
  LOAD #1
  COPY
  PUSH_S substr
  GET
  PUSH_D 1
  PUSH_D 0
  CALL -2
  FREE 4
  LOAD [ei]
  COPY
  PUSH_S equal
  GET
  LOAD #1
  COPY
  PUSH_S substr
  GET
  PUSH_D 1
  PUSH_D 0
