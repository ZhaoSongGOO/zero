include("std");

typedef Custom {
age:
  Int;
next:
  Custom;
__str__:
  object;
};

func showCustom() {
  __print("Custom age is ");
  print(this.age);
  if (this.next != null) {
    print("---call next start---");
    print(this.next);
    print("---call next end---");
  }
}

func main() {
  var a = Int(1);
  var b = Int(2);

  print(a);

  print(a.__data__);
  print(b.__data__);
  swap(a, b);
  print(a.__data__);
  print(b.__data__);

  a = new Custom{age = a, __str__ = showCustom};

  b = new Custom{age = b, next = a, __str__ = showCustom};

  print(a);
  print(b);

  b = new Custom{age = b.age, next = b, __str__ = showCustom};

  print(b);

  var x = Bool(false);

  print(x);
}