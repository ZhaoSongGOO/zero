include("std");

typedef _int_ref_ {
data:
  int;
show:
  object;
};

func customShow() { print(this.data); }

func Int(a) { return new _int_ref_{data = a, show = customShow}; }

typedef Custom {
age:
  Int;
next:
  Custom;
};

func main() {
  var a = Int(1);
  var b = Int(2);

  a.show();

  b.show();
  print(a.data);
  print(b.data);
  swap(a, b);
  print(a.data);
  print(b.data);

  a = new Custom{
      age = a,
  };

  b = new Custom{age = b, next = a};

  print(a);
  print(b);

  b = new Custom{age = b.age, next = b};

  print(b);
}