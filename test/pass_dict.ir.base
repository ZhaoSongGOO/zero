__init__:
test:
  LOAD #-0
  COPY
  PUSH_S run
  GET
  CALL -0
  FREE 2
  LOAD [ei]
  FREE 1
action:
  PUSH_S Running!
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
main:
  PUSH_S run
  LOAD .action
  PUSH_D 1
  CALL native_new_object
  FREE 3
  LOAD [ei]
  STORE #1
  LOAD #1
  CALL test
  FREE 1
  LOAD [ei]
  FREE 1