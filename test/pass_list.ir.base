__init__:
test:
  LOAD #-0
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
main:
  PUSH_S __data__
  PUSH_D 1
  PUSH_D 2
  PUSH_D 3
  PUSH_S Hello
  PUSH_D 4
  CALL native_new_array
  FREE 5
  LOAD [ei]
  PUSH_S count
  PUSH_D 4
  PUSH_D 2
  CALL native_new_object
  FREE 5
  LOAD [ei]
  STORE #1
  LOAD #1
  CALL test
  FREE 1
  LOAD [ei]
  FREE 1