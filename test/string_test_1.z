include("std-library/lite/v1/lib/std-lite-v1");
func main() {
  var s = String("Hello");
  print(s);
  var l = s.len();
  print(l);
  print(s.substr(-1, 2));
  print(s.substr(0, 2));
  print(s.substr(0, 3));
  print(s.substr(0, 4));
  print(s.substr(0, 5));
  print(s.substr(0, 6));
  print(s.substr(0, -1));
}