__init__:
getFib:
  PUSH_D 0
  STORE #1
  PUSH_D 1
  STORE #2
  PUSH_D 0
  STORE #3
  LOAD #-0
  PUSH_D 0
  G
  JF 21
  LOAD #3
  LOAD #1
  LOAD #2
  ADD
  ASSIGN
  STORE #3
  LOAD #1
  LOAD #2
  ASSIGN
  STORE #1
  LOAD #2
  LOAD #3
  ASSIGN
  STORE #2
  LOAD #-0
  LOAD #-0
  PUSH_D 1
  MINUS
  ASSIGN
  STORE #-0
  JUMP -24
  LOAD #1
  STORE [ei]
printSequence:
  PUSH_D 1
  STORE #1
  LOAD #1
  LOAD #-0
  LE
  JF 18
  LOAD #1
  CALL getFib
  FREE 1
  LOAD [ei]
  STORE #2
  LOAD #2
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #1
  LOAD #1
  PUSH_D 1
  ADD
  ASSIGN
  STORE #1
  FREE 1
  JUMP -21
main:
  PUSH_S compute
  LOAD .getFib
  PUSH_S runBatch
  LOAD .printSequence
  PUSH_D 2
  CALL NEW_OBJECT
  FREE 5
  LOAD [ei]
  STORE #1
  PUSH_S name
  PUSH_S Zero Fibonacci Tool
  PUSH_S engine
  LOAD #1
  PUSH_D 2
  CALL NEW_OBJECT
  FREE 5
  LOAD [ei]
  STORE #2
  LOAD #2
  PUSH_S name
  GET
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #2
  PUSH_S engine
  GET
  COPY
  PUSH_S compute
  GET
  PUSH_D 10
  CALL -1
  FREE 3
  LOAD [ei]
  STORE #3
  PUSH_S Result for 10th Fib:
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #3
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  PUSH_S Running batch 1 to 5:
  CALL print
  FREE 1
  LOAD [ei]
  FREE 1
  LOAD #2
  PUSH_S engine
  GET
  COPY
  PUSH_S runBatch
  GET
  PUSH_D 10
  CALL -1
  FREE 3
  LOAD [ei]
  FREE 1