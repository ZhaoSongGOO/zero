func main() {
  var a = 1;
  var b = 2;

  if (a == 1 || b == 2) {
    print("a==1 or b == 2");
  }

  if (a == 1 || b == 3) {
    print("a==1 or b == 3");
  }

  if (a == 2 || b == 3) {
    print("a==2 or b == 3");
  }

  if (a >= 2 || b == 2) {
    print("a>=2 or b == 3");
  }

  if (a == 1 && b == 2) {
    print("a==1 and b==2");
  } else {
    print("not a==1 and b==2");
  }

  if (a == 1 && b == 3) {
    print("a==1 and b==3");
  } else {
    print("not a==1 and b==3");
  }

  if (a == 1 && b == 3) {
    print("[1]:a == 1 && b == 2");
  } else if (b == 3) {
    print("[2]:b == 3");
  } else {
    print("[3]:end!");
  }
}