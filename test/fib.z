include("std");

func getFib(n) {
    var a = 0;
    var b = 1;
    var temp = 0;

    while (n > 0) {
        temp = a + b;
        a = b;
        b = temp;
        n = n - 1;
    }
    return a; 
}

func printSequence(limit) {
    var i = 1;
    while (i <= limit) {
        var res = getFib(i);
        print(res);
        i = i + 1;
    }
}


func main() {
    var mathEngine = {
        "compute": getFib,
        "runBatch": printSequence
    };

    var app = {
        "name": "Zero Fibonacci Tool",
        "engine": mathEngine
    };

    print(app.name);

    var result = app.engine.compute(10);
    print("Result for 10th Fib:");
    print(result);

    print("Running batch 1 to 5:");
    app.engine.runBatch(10); 
}