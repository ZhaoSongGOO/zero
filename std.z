/*
 * Zero Standard Library - Core Module
 * Version: 1.0.0
 * Description: Contains fundamental utility functions for value manipulation
 * and basic arithmetic operations.
 */

/*
 * Swaps the values of two variables.
 * Note: Since this is a function call, ensure your language supports
 * pass-by-reference if you want the changes to reflect outside this scope.
 */
func swap(a, b) {
  var c = a;
  a = b;
  b = c;
}

var version = 100;

func printVersion() { print(version); }

/*
 * Compares two numeric values and returns the greater one.
 */
func max(a, b) {
  if (a > b) {
    return a;
  } else {
    return b;
  }
}

typedef __bool_ref {
data:
  bool;
__str__:
  object;
};

func __bool_print() { __print(this.data); }

func Bool(a) { return new __bool_ref{data = a, __str__ = __bool_print}; }

func __int_print() { __print(this.data); }

typedef __int_ref {
data:
  int;
__str__:
  object;
};

func Int(a) { return new __int_ref{data = a, __str__ = __int_print}; }

/*
 * Returns the sum of two numbers.
 */
func add(a, b) { return a + b; }

func feb(a) {
  if (a == 1) {
    return 1;
  }

  if (a == 2) {
    return 1;
  }

  return feb(a - 1) + feb(a - 2);
}

typedef __list_node {
data:
  object;
next:
  __list_node;
};

typedef __list {
root:
  __list_node;
tail:
  __list_node;
count:
  int;
push:
  object;
each:
  object;
get:
  object;
};

func __list_push(v) {
  var l = new __list_node{data = v};
  if (this.root == null) {
    this.tail = l;
    this.root = l;
  } else {
    this.tail.next = l;
    this.tail = l;
  }
  this.count = this.count + 1;
}

func __list_each(action) {
  if (this.root == null) {
    return null;
  }

  var i = this.root;
  while (i != null) {
    action(i.data);
    i = i.next;
  }
}

func __list_get(index) {
  if (index >= this.count) {
    return null;
  }

  if (index < 0) {
    return null;
  }

  var i = this.root;
  var j = 0;
  while (i != null) {
    if (j == index) {
      return i.data;
    }
    j = j + 1;
    i = i.next;
  }
  return null;
}

func List() {
  return new __list{push = __list_push, count = 0, each = __list_each,
                    get = __list_get};
}
