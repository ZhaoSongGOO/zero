/*
 * Zero Standard Library - Core Module
 * Version: 1.0.0
 * Description: Contains fundamental utility functions for value manipulation
 * and basic arithmetic operations.
 */

/*
 * Swaps the values of two variables.
 * Note: Since this is a function call, ensure your language supports
 * pass-by-reference if you want the changes to reflect outside this scope.
 */
func swap(a, b) {
  var c = a;
  a = b;
  b = c;
}

var version = 100;

func printVersion() { print(version); }

/*
 * Compares two numeric values and returns the greater one.
 */
func max(a, b) {
  if (a > b) {
    return a;
  } else {
    return b;
  }
}

typedef __bool_ref {
__data__:
  bool;
__str__:
  object;
};

func __bool_print() { __print(this.__data__); }

func Bool(a) { return new __bool_ref{__data__ = a, __str__ = __bool_print}; }

func __int_print() { __print(this.__data__); }

typedef __int_ref {
__data__:
  int;
__str__:
  object;
};

func Int(a) { return new __int_ref{__data__ = a, __str__ = __int_print}; }

/*
 * Returns the sum of two numbers.
 */
func add(a, b) { return a + b; }

func feb(a) {
  if (a == 1) {
    return 1;
  }

  if (a == 2) {
    return 1;
  }

  return feb(a - 1) + feb(a - 2);
}

typedef __list_node {
__data__:
  object;
next:
  __list_node;
};

typedef __list {
root:
  __list_node;
tail:
  __list_node;
count:
  int;
push:
  object;
each:
  object;
get:
  object;
};

func __list_push(v) {
  var l = new __list_node{__data__ = v};
  if (this.root == null) {
    this.tail = l;
    this.root = l;
  } else {
    this.tail.next = l;
    this.tail = l;
  }
  this.count = this.count + 1;
}

func __list_each(action) {
  if (this.root == null) {
    return null;
  }

  var i = this.root;
  while (i != null) {
    action(i.__data__);
    i = i.next;
  }
}

func __list_get(index) {
  if (index >= this.count) {
    return null;
  }

  if (index < 0) {
    return null;
  }

  var i = this.root;
  var j = 0;
  while (i != null) {
    if (j == index) {
      return i.__data__;
    }
    j = j + 1;
    i = i.next;
  }
  return null;
}

func List() {
  return new __list{push = __list_push, count = 0, each = __list_each,
                    get = __list_get};
}

typedef __map_node {
key:
  object;
value:
  object;
left:
  __map_node;
right:
  __map_node;
};

typedef __map {
root:
  __map_node;
count:
  int;
insert:
  object;
find:
  object;
each:
  object;
};

func __map_insert_helper(node, key, value) {
  if (node.key.__data__ == key.__data__) {
    node.value = value;
    return node;
  }
  var b = node.key.__data__ < key.__data__;
  if (b) {
    if (node.left == null) {
      node.left = new __map_node{key = key, value = value};
      return node.left;
    } else {
      return __map_insert_helper(node.left, key, value);
    }
  } else {
    if (node.right == null) {
      node.right = new __map_node{key = key, value = value};
      return node.right;
    } else {
      return __map_insert_helper(node.right, key, value);
    }
  }
}

func __map_insert(key, value) {
  if (this.root == null) {
    this.root = new __map_node{key = key, value = value};
    this.count = 0;
    return this.root;
  }
  this.count = this.count + 1;
  return __map_insert_helper(this.root, key, value);
}

func __map_find_helper(node, key) {
  if (node == null) {
    return null;
  }
  if (node.key.__data__ == key.__data__) {
    return node;
  }
  if (key.__data__ < node.key.__data__) {
    return __map_find_helper(node.left, key);
  } else {
    return __map_find_helper(node.right, key);
  }
}

func __map_find(key) { return __map_find_helper(this.root, key); }

func __map_each_helper(node, action) {
  if (node == null) {
    return null;
  }
  action(node);
  __map_each_helper(node.left, action);
  __map_each_helper(node.right, action);
}

func __map_each(action) { __map_each_helper(this.root, action); }

func Map() {
  return new __map{count = 0, insert = __map_insert, find = __map_find,
                   each = __map_each};
}
